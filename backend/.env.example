# Copy to .env and fill in. .env is never committed.

# Required. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Signs session tokens — anyone holding it can forge a login for any user.
SECRET_KEY=

# Required. Leave empty after the '=' only if the account truly has no password.
MYSQL_PASSWORD=

# Optional — these are the defaults
MYSQL_USER=root
MYSQL_HOST=localhost
MYSQL_DB=trading
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
